# /Oliviercontribution — frontend env vars
# Copy to .env.local for local dev, or set in Vercel dashboard for production.

# ── Data provider ─────────────────────────────────────────────────────────────
# Controls which data layer is used. "mock" = fully offline, no backend needed.
# "real" = hits the FastAPI backend (or Sheets backend if VITE_USE_SHEETS=true).
VITE_DATA_PROVIDER=mock

# ── API backend mode ─────────────────────────────────────────────────────────
# FastAPI mode (default): hits VITE_API_URL/api/...
VITE_API_URL=http://localhost:8000
VITE_USE_SHEETS=false

# Sheets mode (Vercel demo): set VITE_USE_SHEETS=true + VITE_SHEETS_WEBHOOK_URL below.
# VITE_USE_SHEETS=true
# VITE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/...../exec

# ── Dev server proxy ──────────────────────────────────────────────────────────
# Used by Vite's dev server to proxy /api requests to the backend.
# In Docker, this is overridden to http://backend:8000 via docker-compose.dev.yml.
VITE_API_PROXY_TARGET=http://localhost:8000