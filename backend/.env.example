HELLO_SALES_APP_NAME=HelloSales API
HELLO_SALES_APP_VERSION=0.1.0
HELLO_SALES_ENVIRONMENT=development
HELLO_SALES_API_PREFIX=/api
HELLO_SALES_LOG_LEVEL=INFO
HELLO_SALES_DATABASE_URL=postgresql+asyncpg://hello_sales:hello_sales@localhost:5432/hello_sales
HELLO_SALES_STAGEFLOW_REQUIRED=false

# Auth provider config
HELLO_SALES_AUTH_PROVIDER=workos
HELLO_SALES_AUTH_REQUIRED=true
# For local CLI smoke runs, override with:
# HELLO_SALES_AUTH_REQUIRED=false
HELLO_SALES_AUTH_SESSION_COOKIE_NAME=hello_sales_session
HELLO_SALES_AUTH_SESSION_COOKIE_SECURE=true
HELLO_SALES_AUTH_SESSION_COOKIE_DOMAIN=
HELLO_SALES_FRONTEND_APP_URL=http://localhost:5173
HELLO_SALES_WORKOS_CLIENT_ID=
HELLO_SALES_WORKOS_API_KEY=
HELLO_SALES_WORKOS_COOKIE_PASSWORD=
HELLO_SALES_WORKOS_REDIRECT_URI=http://localhost:8000/api/auth/callback
HELLO_SALES_WORKOS_BASE_URL=
HELLO_SALES_WORKOS_REQUEST_TIMEOUT_SECONDS=10

HELLO_SALES_OBSERVABILITY_SERVICE_NAME=hello-sales-backend
HELLO_SALES_OBSERVABILITY_SERVICE_VERSION=0.1.0
HELLO_SALES_OBSERVABILITY_METRICS_ENABLED=false
HELLO_SALES_OBSERVABILITY_METRICS_EXPORTER=prometheus
HELLO_SALES_OBSERVABILITY_METRICS_ENDPOINT_ENABLED=false
HELLO_SALES_OBSERVABILITY_METRICS_ENDPOINT_PATH=/metrics
HELLO_SALES_OBSERVABILITY_METRICS_HTTP_ENABLED=true
HELLO_SALES_OBSERVABILITY_METRICS_HEALTH_ENABLED=true
HELLO_SALES_OBSERVABILITY_METRICS_BACKGROUND_TASKS_ENABLED=true
HELLO_SALES_OBSERVABILITY_METRICS_AGENTS_ENABLED=true
HELLO_SALES_OBSERVABILITY_METRICS_WORKERS_ENABLED=true
HELLO_SALES_OBSERVABILITY_TRACING_ENABLED=false
HELLO_SALES_OBSERVABILITY_TRACING_EXPORTER=console
HELLO_SALES_OBSERVABILITY_TRACING_OTLP_ENDPOINT=
HELLO_SALES_OBSERVABILITY_TRACING_OTLP_HEADERS=
HELLO_SALES_OBSERVABILITY_TRACING_OTLP_TIMEOUT_SECONDS=10
HELLO_SALES_OBSERVABILITY_TRACING_HTTP_ENABLED=true
HELLO_SALES_OBSERVABILITY_TRACING_BACKGROUND_TASKS_ENABLED=true
HELLO_SALES_OBSERVABILITY_TRACING_AGENTS_ENABLED=true
HELLO_SALES_OBSERVABILITY_TRACING_WORKERS_ENABLED=true

# Generic agent provider config
HELLO_SALES_GENERIC_AGENT_PROVIDER=groq
HELLO_SALES_GENERIC_AGENT_MODEL=openai/gpt-oss-20b
HELLO_SALES_GENERIC_AGENT_TIMEOUT_SECONDS=30
HELLO_SALES_AGENT_CONTEXT_PROFILE=basic-session-v1

# Public web search provider config
HELLO_SALES_WEB_SEARCH_PROVIDER=tavily
HELLO_SALES_WEB_SEARCH_TIMEOUT_SECONDS=15
HELLO_SALES_WEB_SEARCH_DEFAULT_MAX_RESULTS=5
HELLO_SALES_WEB_SEARCH_REQUIRED=false
HELLO_SALES_WEB_SEARCH_REQUIRES_APPROVAL=false

# Only set this for provider=openai-compatible or if you need to override the default endpoint
HELLO_SALES_GENERIC_AGENT_BASE_URL=

# Provider keys
HELLO_SALES_GROQ_API_KEY=your_api_key_here
HELLO_SALES_TAVILY_API_KEY=your_tavily_api_key_here
HELLO_SALES_WEB_SEARCH_API_KEY=
